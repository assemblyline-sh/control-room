{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability granted to the control-room windows (main and one per host).",
  "windows": ["main", "host-*"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-app-read",
    "fs:allow-app-write",
    "shell:default",
    "shell:allow-open"
  ]
}
