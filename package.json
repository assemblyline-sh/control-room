{
  "name": "control-room",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop window onto Assembly Line factory floors, on this machine and over SSH. Tauri and Next.js; reads al-control's config and runs its probe.",
  "scripts": {
    "dev": "next dev --port 1420",
    "build": "next build",
    "start": "next start --port 1420",
    "lint": "eslint .",
    "format": "prettier --write '**/*.{js,jsx,json,css,md}'",
    "typecheck": "tsc -p jsconfig.json",
    "check:probe": "node scripts/check-probe.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-fs": "^2.0.3",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@assemblyline/al-control": "0.3.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.4.49",
    "prettier": "^3.4.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  }
}
